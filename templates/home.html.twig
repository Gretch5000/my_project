<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Hitch – Share the journey</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F8F9FF;--surface:#fff;--tint:#EFF4FF;--tint2:#E5EEFF;--ink:#0B1C30;--body:#3D4A42;--muted:#565E74;
  --line:#BCCAC0;--olive:#ADB886;--olive-ink:#1C2613;--olive-dk:#596338;--green:#006948;--blue:#0051D5;--amber:#F59E0B;
  --field:#F2F3F9;--chip:#E6F4EE;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0D1420;--surface:#151E2D;--tint:#1A2538;--tint2:#22314A;--ink:#EAF0FB;--body:#C3CCC7;--muted:#9AA6BC;
  --line:#3A4A42;--olive:#ADB886;--olive-ink:#1C2613;--olive-dk:#C4CE9E;--green:#5FD8A6;--blue:#7FA8FF;--field:#1B2639;--chip:#17332B}}
:root[data-theme="dark"]{
  --bg:#0D1420;--surface:#151E2D;--tint:#1A2538;--tint2:#22314A;--ink:#EAF0FB;--body:#C3CCC7;--muted:#9AA6BC;
  --line:#3A4A42;--olive:#ADB886;--olive-ink:#1C2613;--olive-dk:#C4CE9E;--green:#5FD8A6;--blue:#7FA8FF;--field:#1B2639;--chip:#17332B}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--body);font:400 16px/1.5 "Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.wrap{max-width:1280px;margin:0 auto;padding:0 40px}
svg{display:block}
/* header */
header{background:var(--surface);box-shadow:0 1px 8px rgba(11,28,48,.08);position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px;color:var(--olive-dk)}
.logo i{width:35px;height:35px;border-radius:10px;background:var(--olive);display:grid;place-items:center;color:var(--olive-ink)}
nav{display:flex;gap:16px}
nav a{border:1px solid var(--line);border-radius:999px;padding:4px 14px;font-size:14px;font-weight:500;color:var(--ink);background:var(--surface)}
.user{display:flex;align-items:center;gap:14px;font-size:14px;font-weight:600;color:var(--ink)}
.user .av{width:34px;height:34px;border-radius:50%;background:var(--olive);color:var(--olive-ink);display:grid;place-items:center;font-size:13px;font-weight:700}
.user .lang{display:flex;gap:6px;align-items:center;padding-right:14px;border-right:1px solid var(--line);font-weight:500}
.btn-small{background:var(--olive);color:var(--olive-ink);border-radius:8px;padding:8px 16px;font-size:14px;font-weight:600}
/* hero */
.hero{background:linear-gradient(180deg,var(--tint) 0,var(--bg) 100%);padding:48px 0 56px;text-align:center}
.pill{display:inline-flex;align-items:center;gap:8px;background:var(--tint2);border:1px solid color-mix(in srgb,var(--line) 40%,transparent);border-radius:999px;padding:5px 14px;font-size:12px;font-weight:600;color:var(--green)}
.pill::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green)}
h1{font-size:clamp(34px,5vw,48px);line-height:1.15;letter-spacing:-.03em;color:var(--ink);margin:22px auto 18px;max-width:620px;font-weight:700;text-wrap:balance}
.hero p.sub{max-width:580px;margin:0 auto;font-size:17px;color:var(--body)}
.search{max-width:880px;margin:44px auto 0;background:var(--surface);border:1px solid var(--tint2);border-radius:16px;box-shadow:0 2px 12px rgba(11,28,48,.05);text-align:left}
.tabs{display:flex;gap:10px;padding:20px 20px 16px;border-bottom:1px solid var(--tint)}
.tab{display:flex;align-items:center;gap:8px;border:0;border-radius:999px;padding:10px 18px;font-size:15px;font-weight:500;background:var(--tint);color:var(--ink)}
.tab[aria-selected="true"]{background:var(--olive);color:var(--olive-ink)}
.tab small{background:var(--tint2);color:var(--blue);border-radius:999px;padding:2px 9px;font-size:11px;font-weight:600}
.fields{display:grid;grid-template-columns:1.3fr auto 1.3fr 1.1fr 1fr;gap:12px;align-items:end;padding:20px}
.f label{display:block;font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:4px}
.f div{display:flex;align-items:center;gap:10px;height:42px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--field);font-size:15px;font-weight:500;color:var(--ink);white-space:nowrap}
.swap{width:32px;height:32px;border-radius:50%;border:0;background:var(--tint2);color:var(--ink);margin-bottom:5px;display:grid;place-items:center}
.dot{width:14px;height:14px;border-radius:50%;border:2.5px solid var(--green);flex:none}
.btn{display:inline-flex;align-items:center;gap:8px;border:0;background:var(--olive);color:var(--olive-ink);font-weight:600;font-size:18px;border-radius:12px;padding:14px 32px;box-shadow:0 4px 12px rgba(89,99,56,.2)}
.hero .btn{margin-top:36px}
/* impact */
.impact{display:grid;grid-template-columns:1.9fr 1fr 1fr;gap:16px;padding:48px 0}
.card{background:var(--tint);border:1px solid var(--tint2);border-radius:16px;padding:20px}
.big{grid-row:span 2;display:flex;align-items:center;gap:24px;padding:32px 22px;border-color:#BCD0E8}
.badge{width:70px;height:70px;flex:none;border-radius:16px;background:var(--olive);display:grid;place-items:center;font-size:11px;font-weight:700;color:var(--olive-ink);text-align:center}
.big h3{font-size:24px;line-height:1.3;color:var(--ink);margin:6px 0 14px;font-weight:600;letter-spacing:-.01em}
.tag{display:inline-block;background:var(--chip);color:var(--green);border-radius:999px;padding:2px 10px;font-size:11px;font-weight:600}
.link{display:inline-flex;gap:6px;background:var(--surface);border-radius:8px;padding:8px 14px;font-weight:600;font-size:14px;color:var(--green)}
.stat small{display:block;font-size:12px;font-weight:500;color:var(--muted);margin-bottom:6px}
.stat b{display:block;font-size:32px;line-height:1.15;color:var(--ink);font-weight:700}
.stat span{font-size:13px;color:var(--muted)}
.stat .g{color:var(--green)}.stat .b{color:var(--blue)}.star{color:var(--amber)}
/* sections */
.sec{padding:56px 0}
.sec h2{font-size:30px;line-height:1.2;letter-spacing:-.02em;color:var(--ink);margin:0 0 6px;font-weight:700}
.eyebrow{font-size:12px;font-weight:700;color:var(--green);letter-spacing:.04em;margin:0 0 6px}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:28px}
.head a{font-weight:700;font-size:14px;color:var(--green);white-space:nowrap}
.routes{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;align-items:start}
.route{background:var(--surface);border:1px solid var(--tint2);border-radius:16px;padding:20px;box-shadow:0 2px 10px rgba(11,28,48,.04)}
.meta{display:flex;justify-content:space-between;font-size:11px;font-weight:600;color:var(--green);margin-bottom:14px}
.meta span:first-child{background:var(--chip);border-radius:999px;padding:2px 10px}
.meta span:last-child{color:var(--muted)}
.stop{position:relative;padding-left:22px;margin-bottom:12px}
.stop::before{content:"";position:absolute;left:0;top:7px;width:10px;height:10px;border-radius:50%;background:var(--green)}
.stop+.stop::before{background:var(--blue)}
.stop b{display:block;font-size:16px;font-weight:600;color:var(--ink);line-height:1.3}
.stop span{font-size:12.5px;color:var(--muted)}
.note{display:flex;gap:8px;align-items:center;background:var(--bg);border-radius:8px;padding:10px 12px;font-size:12.5px;color:var(--body);margin:14px 0}
.note::before{content:"✓";flex:none;width:14px;height:14px;border-radius:50%;background:var(--blue);color:#fff;font-size:9px;display:grid;place-items:center}
.foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--tint);padding-top:14px}
.foot em{font-style:normal;font-size:13px;color:var(--muted)}
.foot b{font-size:22px;color:var(--green);margin-left:4px}
.foot a{background:var(--tint);color:var(--green);border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600}
.how{background:var(--tint);border-top:1px solid var(--tint2);text-align:center}
.how p.lead{max-width:540px;margin:6px auto 0;font-size:15px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:48px;text-align:left}
.step{background:var(--surface);border:1px solid var(--tint2);border-radius:16px;padding:28px;display:flex;flex-direction:column;min-height:330px}
.num{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-weight:700;font-size:16px;margin-bottom:28px;background:var(--bg);color:var(--olive-dk);border:1px solid var(--line)}
.step:nth-child(2) .num{background:var(--tint2);color:var(--blue);border-color:transparent}
.step:nth-child(3) .num{background:var(--olive);color:var(--olive-ink);border-color:transparent}
.step h3{font-size:18px;margin:0 0 10px;color:var(--ink);font-weight:600}
.step p{margin:0 0 auto;font-size:15px}
.step footer{border-top:1px solid var(--tint);margin-top:24px;padding-top:14px;font-size:12px;font-weight:600;color:var(--green)}
.step:nth-child(2) footer{color:var(--blue)}
/* cta */
.cta{margin:0 auto;border-radius:24px;padding:56px;color:#fff;background:radial-gradient(circle at 12% 70%,#0A2A5E 0,transparent 38%),radial-gradient(circle at 92% 20%,#0A3A3A 0,transparent 40%),#0B1C30;box-shadow:0 20px 40px rgba(11,28,48,.18)}
.cta .pill{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#85F8C4}
.cta .pill::before{display:none}
.cta h2{color:#fff;font-size:34px;margin:18px 0 14px;max-width:700px}
.cta p{max-width:660px;margin:0 0 28px;font-size:18px;color:#C5D0E0}
.cta .row{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.cta .btn{font-size:18px}
.ghost{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:10px;padding:14px 24px;font-weight:600;font-size:16px}
/* footer */
.site{background:var(--tint);border-top:1px solid var(--tint2);margin-top:64px;padding:40px 0}
.site .top{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-bottom:20px;border-bottom:1px solid var(--tint2)}
.site .logo{color:var(--olive);opacity:.85}
.site .links{display:flex;gap:24px;flex-wrap:wrap;font-size:12.5px;font-weight:600;color:var(--body)}
.site .bot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:18px;font-size:13px;color:var(--body)}
.site .bot b{font-size:12px;color:var(--olive-dk)}
/* responsive */
@media(max-width:1000px){
  .fields{grid-template-columns:1fr 1fr}.swap{display:none}
  .impact{grid-template-columns:1fr 1fr}.big{grid-column:1/-1;grid-row:auto}
  .routes{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr}.step{min-height:0}
  nav{display:none}}
@media(max-width:640px){
  .wrap{padding:0 20px}.fields,.routes,.impact{grid-template-columns:1fr}
  .big{flex-direction:column;align-items:flex-start}.cta{padding:32px 24px}
  .user .lang,.user span.n{display:none}.head{flex-direction:column;align-items:flex-start}.tabs{flex-wrap:wrap}}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="logo" href="{{ path('home') }}"><i><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-7M12 15 6 5M12 15l6-10M4 7l2-2 3 1"/></svg></i>The Hitch</a>
    <nav aria-label="Main"><a href="#corridors">Explore</a><a href="#offer">Offer a Ride</a><a href="#how">How it Works</a></nav>
    <div class="user">
      {% if app.user %}
        <span>{{ app.user.firstName }}</span>
        <a href="{{ path('app_logout') }}">Log out</a>
      {% else %}
        <a href="{{ path('app_login') }}">Sign In</a>
        <a class="btn-small" href="{{ path('app_register') }}">Sign up</a>
      {% endif %}
    </div>
  </div>
</header>

<main id="top">
<section class="hero">
  <div class="wrap">
    <span class="pill">Share the journey. Make the trip count.</span>
    <h1>Your journey. Their ride. One better way to travel.</h1>
    <p class="sub">Connect with verified drivers already traveling your route across France. Share rides or transport parcels cleanly and securely.</p>

    <form class="search" onsubmit="return false">
      <div class="tabs" role="tablist">
        <button type="button" class="tab" role="tab" aria-selected="true" data-mode="Find a Ride">Passenger</button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-mode="Find a Parcel Route">Parcels &amp; Cargo <small>−60% Cost</small></button>
      </div>
      <div class="fields">
        <div class="f"><label>Departure (From)</label><div><span class="dot"></span><span id="from">Paris (Gare de Lyon)</span></div></div>
        <button type="button" class="swap" id="swap" aria-label="Swap departure and destination"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4 3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/></svg></button>
        <div class="f"><label>Destination (To)</label><div><svg width="16" height="16" viewBox="0 0 24 24" fill="var(--blue)"><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.500 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg><span id="to">Lyon (Part-Dieu)</span></div></div>
        <div class="f"><label>Date</label><div>Sat, 18 Oct 2025</div></div>
        <div class="f"><label>How many people?</label><div>1 Passenger</div></div>
      </div>
    </form>
    <button class="btn" id="go" type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span id="golabel">Find a Ride</span></button>
  </div>
</section>

<div class="wrap">
  <section class="impact" aria-label="Impact">
    <div class="card big">
      <div class="badge">ADEME</div>
      <div>
        <span class="tag">Certified Baseline Audit 2026</span>
        <h3>−42 kg CO₂ saved per shared journey on average</h3>
        <p style="margin:0 0 14px;font-size:15px">Click below to see how much carbon footprint you have saved up to now.</p>
        <a class="link" href="#karma">My Karma →</a>
      </div>
    </div>
    <div class="card stat"><small>Verified Co-Travelers</small><b>450,000+</b></div>
    <div class="card stat"><small>Cumulative CO₂ Diverted</small><b class="g">34,820 t</b><span>Equiv. 1.7M trees</span></div>
    <div class="card stat"><small>Average Driver Rating</small><b>4.94 <span class="star">★</span></b><span>Across 820,000 reviews</span></div>
    <div class="card stat"><small>Cargo Claim Rate</small><b class="b">0.002%</b><span>Backed by MAIF escrow</span></div>
  </section>
</div>

<section class="sec" id="corridors" style="background:var(--bg)">
  <div class="wrap">
    <p class="eyebrow">Metropolitan network</p>
    <div class="head">
      <div><h2>Popular French Intercity Corridors</h2><span style="font-size:15px">Frequent guaranteed carpools and scheduled parcel logistics between major French transport hubs.</span></div>
      <a href="#corridors">Explore All 140+ Corridors →</a>
    </div>
    <div class="routes" id="routes"></div>
  </div>
</section>

<section class="sec how" id="how">
  <div class="wrap">
    <p class="eyebrow">Simplicity &amp; civic protocol</p>
    <h2>How The Hitch Works</h2>
    <p class="lead">A verified 3-step loop linking travelers with empty seats or cargo room for fair, zero-stress transit.</p>
    <div class="steps">
      <div class="step"><div class="num">01</div><h3>1. Search or Offer a Route</h3><p>Whether you commute weekly or take an occasional intercity road trip, publish your scheduled route or search for available rides and trunk capacity.</p><footer>Intelligent detour prevention matching</footer></div>
      <div class="step"><div class="num">02</div><h3>2. Reserve Securely with FranceConnect</h3><p>Identity is checked through institutional French digital ID. Payments remain in state-compliant escrow until the passenger arrives or the parcel is handed over.</p><footer>Escrow held with Banque Populaire</footer></div>
      <div class="step"><div class="num">03</div><h3>3. Ride or Ship Cleanly</h3><p>Meet at convenient park-and-ride spots or transit stations. Scan the handshake QR code upon delivery or arrival to unlock payment and log your CO₂ savings.</p><footer>Contactless instant handover proof</footer></div>
    </div>
  </div>
</section>

<div class="wrap" style="margin-top:64px" id="offer">
  <section class="cta">
    <span class="pill">Citizen Mobility Community</span>
    <h2>Join 450,000 verified travelers across France</h2>
    <p>Whether you want to subsidize your commute fuel costs, avoid single-occupancy driving, or send urgent regional parcels affordably, your account unlocks instant verified journeys.</p>
    <div class="row"><a class="btn" href="{{ path('app_register') }}">Create an Account</a><a class="ghost" href="#how">Learn Driver Terms &amp; Guarantee</a></div>
  </section>
</div>
</main>

<footer class="site">
  <div class="wrap">
    <div class="top">
      <span class="logo"><i><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-7M12 15 6 5M12 15l6-10M4 7l2-2 3 1"/></svg></i>The Hitch</span>
      <div class="links"><a href="#">Legal Notice</a><a href="#">Terms of Service</a><a href="#">Privacy Policy</a><a href="#">FranceConnect Verification</a><a href="#">CO₂ Impact Methodology</a><a href="#">Safety &amp; Trust</a></div>
    </div>
    <div class="bot"><span>© 2025 The Hitch Eco-Mobility. Verified sustainable carpool &amp; package transit. All rights reserved. Over 1,420 tons of CO₂ saved to date.</span><b>● Official French Mobility Partner</b></div>
  </div>
</footer>

<script>
(function(){
  var R=[
    ["48","48","Paris","Gare de Lyon / Bercy","Lyon","Part-Dieu / Perrache","Avg. departure every 25 mins","25"],
    ["34","32","Bordeaux","Saint-Jean","Toulouse","Matabiau / Blagnac","Direct A62 highway corridor","18"],
    ["52","19","Nantes","Gare Sud / Commerce","Rennes","Gare Centrale / Villejean","Express regional route: 1h15m","14"],
    ["42","35","Lille","Flandres / Europe","Paris","Porte de la Chapelle / Nord","Direct A1 route with parcel lockers","19"]
  ];
  document.getElementById("routes").innerHTML=R.map(function(r){
    return '<article class="route"><div class="meta"><span>Daily: '+r[0]+' departures</span><span>−'+r[1]+' kg CO₂</span></div>'
    +'<div class="stop"><b>'+r[2]+'</b><span>'+r[3]+'</span></div><div class="stop"><b>'+r[4]+'</b><span>'+r[5]+'</span></div>'
    +'<div class="note">'+r[6]+'</div>'
    +'<div class="foot"><span><em>from</em><b>€'+r[7]+'</b></span><a href="#top">Book Seat or Box</a></div></article>';
  }).join("");

  var tabs=document.querySelectorAll(".tab"),label=document.getElementById("golabel");
  tabs.forEach(function(t){t.addEventListener("click",function(){
    tabs.forEach(function(x){x.setAttribute("aria-selected",x===t?"true":"false")});
    label.textContent=t.getAttribute("data-mode");
  })});
  document.getElementById("swap").addEventListener("click",function(){
    var a=document.getElementById("from"),b=document.getElementById("to"),t=a.textContent;
    a.textContent=b.textContent;b.textContent=t;
  });
    document.getElementById("go").addEventListener("click", function () {
    var type = label.textContent.indexOf("Parcel") > -1 ? "parcel" : "ride";
    window.location.href = "{{ path('app_find_ride') }}?type=" + type;
  });
})();
</script>
</body>
</html>
